# Storacha (web3.storage w3up)
# Sign up at web3.storage, create a space, then run:
#   npx w3 key create  → paste the private key below
#   npx w3 proof create --can 'store/*' --can 'upload/*' --space <DID> → base64 encode and paste below
STORACHA_KEY=
STORACHA_PROOF=

# Africa's Talking SMS
# Sign up at africastalking.com → Sandbox → API Key
AT_API_KEY=
AT_USERNAME=sandbox
AT_SENDER_ID=CortexVault
